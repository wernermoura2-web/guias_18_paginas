<</JS(var v = app.viewerVersion;\nif \(v < 7\)\n{\n\tvar n = 0;\n\tif \(this.dataObjects != null\)\n\t\tn = this.dataObjects.length;\n\tif \(v >= 5 && v < 6 && n > 0 && \(app.viewerVariation == "Full" || app.viewerVariation == "Fill-In"\)\)\n\t{\n\t\tif \(this.external\)\n\t\t\tapp.alert\("Este documento tem anexos de arquivo. Para v\352-los, clique no bot\343o Salvar para salvar uma c\363pia do documento, abra a c\363pia no Adobe Acrobat, e use o menu Arquivo > Propriedades do documento > Objetos de dados incorporados.", 3, 0\);\n\t\telse\n\t\t\tapp.alert\("Este documento tem anexos de arquivo. Para v\352-los, use o menu Arquivo > Propriedades do documento > Objetos de dados incorporados.", 3, 0\);\n\t}\n\telse if \(v >= 6 && v < 7\)\n\t{\n\t\tif \(n == 0\)\n\t\t{\n\t\t\tvar np = this.numPages;\n\t\t\tsyncAnnotScan\(\);\n\t\t\tfor \(var p = 0; p < np && n == 0; ++p\)\n\t\t\t{\n\t\t\t\tvar annots = this.getAnnots\(p\);\n\t\t\t\tif \(annots != null\)\n\t\t\t\t{\n\t\t\t\t\tfor \(var i = 0; i < annots.length; ++i\)\n\t\t\t\t\t{\n\t\t\t\t\t\tif \(annots[i].type == "FileAttachment"\)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tn = 1;\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif \(n > 0\)\n\t\t{\n\t\t\tif \(this.external\)\n\t\t\t\tapp.alert\("Este documento tem anexos de arquivo. Para v\352-los, clique no tri\342ngulo preto, na parte superior da barra de rolagem vertical da janela do documento, e escolha Anexos de arquivo.", 3, 0\);\n\t\t\telse\n\t\t\t\tapp.alert\("Este documento tem anexos de arquivo. Para v\352-los, use o menu Documento > Anexo de arquivo.", 3, 0\);\n\t\t}\n\t}\n}\n)/S/JavaScript>>
endobj

