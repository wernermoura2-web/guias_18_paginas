","BPF_F_Group204_3"],"questions":[{"answer":"BPF_F_Group204_1","note":"BPF_Obs_Group204_1","label":"F1"},{"answer":"BPF_F_Group204_2","note":"BPF_Obs_Group204_2","label":"F2"},{"answer":"BPF_F_Group204_3","note":"BPF_Obs_Group204_3","label":"F3"}]}]},"11_4.10.6":{"page":11,"template":"BPF_Item_11_4.10.6","fields":["BPF_F_Group205_1","BPF_Obs_Group205_1","BPF_F_Group205_2","BPF_Obs_Group205_2"],"code":"4.10.6","observationField":"OBSERVA\307\325ES4106","scopes":[{"target":"Group205","unit":"L1","label":"Avalia\347\343o","fields":["BPF_F_Group205_1","BPF_F_Group205_2"],"questions":[{"answer":"BPF_F_Group205_1","note":"BPF_Obs_Group205_1","label":"F1"},{"answer":"BPF_F_Group205_2","note":"BPF_Obs_Group205_2","label":"F2"}]}]},"11_4.12.6":{"page":11,"template":"BPF_Item_11_4.12.6","fields":["BPF_F_Group206_1","BPF_Obs_Group206_1"],"code":"4.12.6","observationField":"OBSERVA\307\325ES4126","scopes":[{"target":"Group206","unit":"L1","label":"Avalia\347\343o","fields":["BPF_F_Group206_1"],"questions":[{"answer":"BPF_F_Group206_1","note":"BPF_Obs_Group206_1","label":"F1"}]}]},"12_4.11.1":{"page":12,"template":"BPF_Item_12_4.11.1","fields":["BPF_F_Group210_1","BPF_Obs_Group210_1"],"code":"4.11.1","observationField":"OBSERVA\307\325ES4111","scopes":[{"target":"Group210","unit":"L1","label":"Avalia\347\343o","fields":["BPF_F_Group210_1"],"questions":[{"answer":"BPF_F_Group210_1","note":"BPF_Obs_Group210_1","label":"F1"}]}]},"12_4.11.2":{"page":12,"template":"BPF_Item_12_4.11.2","fields":["BPF_F_Group211_1","BPF_Obs_Group211_1","BPF_F_Group211_2","BPF_Obs_Group211_2","BPF_F_Group211_3","BPF_Obs_Group211_3","BPF_F_Group211_4","BPF_Obs_Group211_4","BPF_F_Group211_5","BPF_Obs_Group211_5","BPF_F_Group211_6","BPF_Obs_Group211_6"],"code":"4.11.2","observationField":"OBSERVA\307\325ES4112","scopes":[{"target":"Group211","unit":"L1","label":"Avalia\347\343o","fields":["BPF_F_Group211_1","BPF_F_Group211_2","BPF_F_Group211_3","BPF_F_Group211_4","BPF_F_Group211_5","BPF_F_Group211_6"],"questions":[{"answer":"BPF_F_Group211_1","note":"BPF_Obs_Group211_1","label":"F1"},{"answer":"BPF_F_Group211_2","note":"BPF_Obs_Group211_2","label":"F2"},{"answer":"BPF_F_Group211_3","note":"BPF_Obs_Group211_3","label":"F3"},{"answer":"BPF_F_Group211_4","note":"BPF_Obs_Group211_4","label":"F4"},{"answer":"BPF_F_Group211_5","note":"BPF_Obs_Group211_5","label":"F5"},{"answer":"BPF_F_Group211_6","note":"BPF_Obs_Group211_6","label":"F6"}]}]},"12_4.11.3":{"page":12,"template":"BPF_Item_12_4.11.3","fields":["BPF_F_Group212_1","BPF_Obs_Group212_1"],"code":"4.11.3","observationField":"OBSERVA\307\325ES4113","scopes":[{"target":"Group212","unit":"L1","label":"Avalia\347\343o","fields":["BPF_F_Group212_1"],"questions":[{"answer":"BPF_F_Group212_1","note":"BPF_Obs_Group212_1","label":"F1"}]}]},"12_4.11.4":{"page":12,"template":"BPF_Item_12_4.11.4","fields":["BPF_F_Group213_1","BPF_Obs_Group213_1"],"code":"4.11.4","observationField":"OBSERVA\307\325ES4114","scopes":[{"target":"Group213","unit":"L1","label":"Avalia\347\343o","fields":["BPF_F_Group213_1"],"questions":[{"answer":"BPF_F_Group213_1","note":"BPF_Obs_Group213_1","label":"F1"}]}]}};\n/* Estado em widgets ocultos, como no guia APPCC; recuper\341vel entre a\347\365es do leitor. */\nvar BPF_ACTIVE=null,BPF_CLOSE_DOC=null,BPF_CLOSE_PAGE=-1,BPF_SAVING=false,BPF_CLOSE_TIMER=null,BPF_CLOSE_BACK=-1;\nfunction bpfPdfRead\(name\){var f=this.getField\(name\);if\(!f\)return '';return String\(f.valueAsString!==undefined?f.valueAsString:\(f.value!==undefined?f.value:''\)\);}\nfunction bpfPdfWrite\(name,value\){var f=this.getField\(name\);if\(!f\)throw Error\('Campo interno n\343o encontrado: '+name\);if\(bpfPdfRead.call\(this,name\)!==String\(value\)\)f.value=value;}\nfunction bpfPdfState\(\){var raw=bpfPdfRead.call\(this,'BPF_State'\);try{return JSON.parse\(raw||'{}'\);}catch\(e\){throw Error\('N\343o foi poss\355vel recuperar as respostas salvas.'\);}}\nfunction bpfPdfPage\(name,fallback\){var f=this.getField\(name\),p=f?f.page:null;if\(typeof p==='number'&&p>=0\)return p;if\(p&&p.length\)for\(var i=0;i<p.length;i++\)if\(p[i]>=0\)return p[i];return fallback;}\nfunction bpfPdfSetActive\(active\){BPF_ACTIVE=active;bpfPdfWrite.call\(this,'BPF_Active',active?JSON.stringify\(active\):''\);}\nfunction bpfPdfEditorField\(active,name\){return this.getField\(active.prefix+name\);}\nfunction bpfPdfEditorRead\(active,name\){var f=bpfPdfEditorField.call\(this,active,name\);if\(!f\)throw Error\('Campo da p\341gina F n\343o encontrado: '+name\);return String\(f.valueAsString!==undefined?f.valueAsString:\(f.value!==undefined?f.value:''\)\);}\nfunction bpfPdfRecoverActive\(key\){\n if\(BPF_ACTIVE&&\(!key||BPF_ACTIVE.key===key\)\)return BPF_ACTIVE;\n var raw=bpfPdfRead.call\(this,'BPF_Active'\);if\(raw\){try{var a=JSON.parse\(raw\);if\(a&&BPF_PDF_ITEMS[a.key]&&\(!key||a.key===key\)\){BPF_ACTIVE=a;return a;}}catch\(e\){}}\n if\(key&&BPF_PDF_ITEMS[key]\){var item=BPF_PDF_ITEMS[key],prefix='P'+\(item.page+1\)+'.'+item.template+'.',page=bpfPdfPage.call\(this,prefix+'BPF_Close_'+key+'_top',-1\);if\(page>=0\){var back=bpfPdfPage.call\(this,'BPF_Open_'+key,item.page\),recovered={key:key,page:page,back:back,prefix:prefix};bpfPdfSetActive.call\(this,recovered\);return recovered;}}\n return null;\n}\nfunction bpfPdfMergeObservation\(text,code,previous,summary\){var start='[Frases '+code+']',end='[/Frases '+code+']',a=text.indexOf\(start\);if\(a>=0\){var b=text.indexOf\(end,a\);if\(b>=0\)text=text.substring\(0,a\)+text.substring\(b+end.length\);}if\(previous\){a=text.indexOf\(previous\);if\(a>=0\)text=text.substring\(0,a\)+text.substring\(a+previous.length\);}text=text.replace\(/\\s+$/,''\);return text+\(summary?\(text?' ':''\)+summary:''\);}\nfunction bpfPdfSave\(key\){\n var active=bpfPdfRecoverActive.call\(this,key\);if\(!active||active.closing||BPF_SAVING\)return false;BPF_SAVING=true;var suspended=false,oldCalculate;\n try{try{oldCalculate=this.calculate;if\(typeof oldCalculate==='boolean'\){this.calculate=false;suspended=true;}}catch\(ignore\){}\n  var state=bpfPdfState.call\(this\),item=BPF_PDF_ITEMS[active.key],names=item.fields;\n  for\(var i=0;i<names.length;i++\){var f=bpfPdfEditorField.call\(this,active,names[i]\);if\(f\)state[names[i]]=bpfPdfEditorRead.call\(this,active,names[i]\)||\(names[i].indexOf\('BPF_Obs_'\)===0?'':'Sem resposta'\);}\n  var scopes=item.scopes||[],entries=[],answeredScopes=0;\n  for\(var j=0;j<scopes.length;j++\){var questions=scopes[j].questions||[],hasAnswer=false;for\(var q=0;q<questions.length;q++\)if\(state[questions[q].answer]&&state[questions[q].answer]!=='Sem resposta'\)hasAnswer=true;if\(hasAnswer\)answeredScopes++;}\n  for\(var j=0;j<scopes.length;j++\){var sc=scopes[j],no=false,empty=false,allNA=true;\n   for\(var k=0;k<sc.fields.length;k++\){var v=state[sc.fields[k]]||'Sem resposta';if\(v==='N\343o'\)no=true;if\(v==='Sem resposta'\)empty=true;if\(v!=='N\343o se aplica'\)allNA=false;}\n   bpfPdfWrite.call\(this,sc.target,no?'0':empty?'Off':allNA?'2':'1'\);\n   var questions=sc.questions||[];for\(var q=0;q<questions.length;q++\){var question=questions[q],answer=state[question.answer]||'Sem resposta';if\(answer!=='Sem resposta'\)entries.push\(\(answeredScopes>1?sc.unit+'/':''\)+question.label+': '+\(answer==='N\343o se aplica'?'NA':answer\)\);}\n  }\n  if\(!state._summaries\)state._summaries={};var summary=entries.length?item.code+' '+entries.join\('; '\)+'.':'';\n  var obs=this.getField\(item.observationField\);if\(obs\){bpfPdfWrite.call\(this,item.observationField,bpfPdfMergeObservation\(bpfPdfRead.call\(this,item.observationField\),item.code,state._summaries[active.key]||'',summary\)\);try{if\(obs.textSize!==0\)obs.textSize=0;}catch\(ignore\){}}\n  state._summaries[active.key]=summary;bpfPdfWrite.call\(this,'BPF_State',JSON.stringify\(state\)\);\n }finally{if\(suspended\)this.calculate=oldCalculate;BPF_SAVING=false;}\n if\(oldCalculate!==false\)this.calculateNow\(\);return true;\n}\nfunction bpfPdfDelete\(\){\n var doc=BPF_CLOSE_DOC||\(this&&typeof this.getField==='function'?this:null\);if\(!doc\)return;\n var active=bpfPdfRecoverActive.call\(doc\),pg=BPF_CLOSE_PAGE>=0?BPF_CLOSE_PAGE:\(active&&active.closing?active.page:-1\);if\(pg<0\)return;\n // Finish field writes before deletion; do not access document fields after deleting the page.\n bpfPdfSetActive.call\(doc,null\);BPF_CLOSE_DOC=null;BPF_CLOSE_PAGE=-1;BPF_CLOSE_BACK=-1;BPF_CLOSE_TIMER=null;\n try{doc.deletePages\(pg,pg\);}catch\(e\){app.alert\('O resumo foi salvo no guia. O leitor manteve a p\341gina F aberta: '+e\);}\n}\nfunction bpfPdfReturn\(\){var doc=BPF_CLOSE_DOC;if\(!doc\)return;var back=BPF_CLOSE_BACK;if\(back>=0\)doc.pageNum=back;BPF_CLOSE_TIMER=app.setTimeOut\('bpfPdfDelete\(\);',750\);}\nfunction bpfPdfClose\(key\){\n try{var active=bpfPdfRecoverActive.call\(this,key\);if\(!active||active.closing\)return;if\(!bpfPdfSave.call\(this,active.key\)\)return;\n  active.closing=true;bpfPdfSetActive.call\(this,active\);BPF_CLOSE_DOC=this;BPF_CLOSE_PAGE=active.page;BPF_CLOSE_BACK=active.back;\n  // Leave the field event first, return to the guide, then remove the temporary page.\n  BPF_CLOSE_TIMER=app.setTimeOut\('bpfPdfReturn\(\);',250\);\n }catch\(e\){app.alert\('N\343o foi poss\355vel concluir o salvamento. A p\341gina F foi mantida para preservar o preenchimento: '+e\);}\n}\nfunction bpfPdfOpen\(key\){\n try{var old=bpfPdfRecoverActive.call\(this\);if\(old&&old.closing\){BPF_CLOSE_DOC=this;BPF_CLOSE_PAGE=old.page;bpfPdfDelete.call\(this\);old=bpfPdfRecoverActive.call\(this\);}\n  if\(old\){if\(old.key===key\){this.pageNum=old.page;return;}if\(!bpfPdfSave.call\(this,old.key\)\)return;old.closing=true;bpfPdfSetActive.call\(this,old\);BPF_CLOSE_DOC=this;BPF_CLOSE_PAGE=old.page;bpfPdfDelete.call\(this\);if\(bpfPdfRecoverActive.call\(this\)\)return;}\n  var item=BPF_PDF_ITEMS[key];if\(!item\)return;var back=bpfPdfPage.call\(this,'BPF_Open_'+key,item.page\),pos=back+1,t=this.getTemplate\(item.template\),active={key:key,page:pos,back:back,prefix:'P'+pos+'.'+item.template+'.'};\n  bpfPdfSetActive.call\(this,active\);try{t.spawn\(pos,true,false\);}catch\(e\){bpfPdfSetActive.call\(this,null\);throw e;}bpfPdfSetActive.call\(this,active\);\n  var state=bpfPdfState.call\(this\);for\(var i=0;i<item.fields.length;i++\){var name=item.fields[i];var field=bpfPdfEditorField.call\(this,active,name\);if\(!field\)throw Error\('Este leitor n\343o criou os campos individuais da p\341gina F.'\);if\(state[name]!==undefined&&String\(field.valueAsString\)!==String\(state[name]\)\)field.value=state[name];}this.pageNum=pos;\n }catch\(e\){app.alert\('N\343o foi poss\355vel abrir as frases deste item: '+e\);}\n}\n)>>
endobj

