615 0 obj
<</JS(// Lista dos campos de origem\r\nvar campos = ["Group700", "Group705", "Group710", "Group720"];\r\n\r\n// Verifica se algum est\341 marcado como 0\r\nvar algumMarcado = campos.some\(function\(nome\) {\r\n    return Number\(this.getField\(nome\).value\) === 0;\r\n}, this\);\r\n\r\n// Define o campo de destino\r\nvar destino = this.getField\("Group730"\);\r\n\r\n// Atualiza automaticamente o campo de destino\r\ndestino.value = algumMarcado ? 0 : 1;)/S/JavaScript>>
endobj

