<</Type/Action/S/JavaScript/JS(\nfunction guiaSituacaoDocumento\(i,v\){var f=this.getField\('doc_legal_'+i+'_atende'\);if\(!f\)return;var habilitar=String\(v\)==='Entregue';if\(!habilitar\)f.value='';f.readonly=!habilitar;f.fillColor=habilitar?['RGB',1,1,1]:['RGB',.9,.9,.9];}\nfunction guiaRestaurarDocumentos\(\){for\(var i=1;i<=8;i++\){var s=this.getField\('doc_legal_'+i+'_situacao'\);if\(s\)guiaSituacaoDocumento.call\(this,i,s.value\);}}\nguiaRestaurarDocumentos.call\(this\);\n)>>
