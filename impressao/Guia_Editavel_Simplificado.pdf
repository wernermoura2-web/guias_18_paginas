1920 0 obj
<</JS(// Obt\351m os valores dos campos\r\nvar g1 = +this.getField\("Group170"\).value;\r\nvar g2 = +this.getField\("Group176"\).value;\r\nvar g3 = +this.getField\("Group178"\).value;\r\nvar g4 = +this.getField\("Group183"\).value;\r\n\r\nif \(g1 === 2 && g2 === 0 && g3 === 0 && g4 === 0\){\r\n    var total = 0;\r\n    var soma = 0;\r\n} else {\r\n    var total = 4;\r\n    var soma = g1 + g2 + g3 + g4;\r\n}\r\n\r\n// Se todos estiverem em branco ou zero, deixa o campo vazio\r\nif \(isNaN\(soma\) || soma === 0\) {\r\n    event.value = "";\r\n} else {\r\n    var porcentagem = \(soma / total\) * 100;\r\n    event.value = porcentagem.toFixed\(0\) + "%";\r\n}\r\nif \(soma === 0\) {\r\n    event.value = "";\r\n}\r\n\r\nif \(g1 === 0 && g2 === 0 && g3 === 0 && g4 === 0\) \r\n  event.value = "0 %";\r\nif \(g1 === 2 && g2 === 2 && g3 === 2 && g4 === 2\) \r\n  event.value = "";\r\n)/S/JavaScript>>
endobj

