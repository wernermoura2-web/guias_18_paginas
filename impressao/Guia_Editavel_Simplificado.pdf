936 0 obj
<</JS(// Obt\351m os valores dos campos\r\nvar g1 = +this.getField\("Group80"\).value;\r\nvar g2 = +this.getField\("Group85"\).value;\r\nvar g3 = +this.getField\("Group105"\).value;\r\nvar g4 = +this.getField\("Group95"\).value;\r\nvar g5 = +this.getField\("Group104"\).value;\r\n\r\n// Conta quantos campos foram respondidos \(para evitar divis\343o por zero\)\r\nvar total = 5; // n\372mero total de perguntas\r\nvar soma = g1 + g2 + g3 + g4 + g5;\r\n\r\n// Se todos estiverem em branco ou zero, deixa o campo vazio\r\nif \(isNaN\(soma\) || soma === 0\) {\r\n    event.value = "";\r\n} else {\r\n    var porcentagem = \(soma / total\) * 100;\r\n    event.value = porcentagem.toFixed\(0\) + "%";\r\n}\r\nif \(g1 === 0 && g2 === 0 && g3 === 0 && g4 === 0 && g5 === 0\) \r\n  event.value = "0 %";)/S/JavaScript>>
endobj

