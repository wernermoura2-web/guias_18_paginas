4333 0 obj
<</JS(// Nome do campo que cont\351m a porcentagem\r\nvar campoPercentual = this.getField\("fill_15"\).value;\r\n\r\n// Obt\351m o checkbox \(Group\) que deve mudar de cor\r\nvar campo = this.getField\("Dropdown100"\);\r\n\r\n// Remove o s\355mbolo % \(caso exista\) e converte em n\372mero\r\nvar valor = parseFloat\(campoPercentual\);\r\n\r\n// Se o valor n\343o for v\341lido \(vazio, NaN etc.\), deixa o campo em branco\r\nif \(isNaN\(valor\)\) {\r\n    event.value = "";\r\n    campo.strokeColor = color.white;\r\n} else if \(valor <= 50\) {\r\n    event.value = "3";\r\n    campo.strokeColor = color.red;\r\n} else if \(valor > 50 && valor <= 75\) {\r\n    event.value = "2";\r\n    campo.strokeColor = color.yellow;\r\n} else if \(valor > 75\) {\r\n    event.value = "1";\r\n    campo.strokeColor = color.green;\r\n} else {\r\n    event.value = "";\r\n    campo.fillColor = color.white; // padr\343o\r\n}\r\n)/S/JavaScript>>
endobj

