4321 0 obj
<</JS(// Nome do campo que cont\351m a porcentagem\r\nvar campoPercentual1 = this.getField\("fill_16_2"\).value;\r\nvar campoPercentual2 = this.getField\("fill_16_3"\).value;\r\nvar campoPercentual3 = this.getField\("fill_16_4"\).value;\r\nvar campoPercentual4 = this.getField\("fill_16_5"\).value;\r\n\r\n// Remove o s\355mbolo % \(caso exista\) e converte em n\372mero\r\nvar valor1 = parseFloat\(campoPercentual1\);\r\nvar valor2 = parseFloat\(campoPercentual2\);\r\nvar valor3 = parseFloat\(campoPercentual3\);\r\nvar valor4 = parseFloat\(campoPercentual4\);\r\n\r\n// Obt\351m o checkbox \(Group\) que deve mudar de cor\r\nvar campo = this.getField\("Dropdown65"\);\r\n\r\nif \(isNaN\(valor4\)\) {\r\n    var valor4 = 100;\r\n}\r\nif \(isNaN\(valor3\)\) {\r\n    var valor3 = 100;\r\n}\r\nif \(isNaN\(valor2\)\) {\r\n    var valor2 = 100;\r\n}\r\n\r\n// Se o valor n\343o for v\341lido \(vazio, NaN etc.\), deixa o campo em branco\r\nif \(\(valor1 < valor2\) && \(valor1 < valor3\) && \(valor1 < valor4\)\) {\r\n    var valor = valor1;\r\n} else if \(\(valor2 < valor1\) && \(valor2 < valor3\) && \(valor2 < valor4\)\) {\r\n    var valor = valor2;\r\n} else if \(\(valor3 < valor1\) && \(valor3 < valor2\) && \(valor3 < valor4\)\) {\r\n    var valor = valor3;\r\n} else {\r\n    var valor = valor4;\r\n}\r\n\r\nif \(isNaN\(valor\)\) {event.value="";} else if\(valor<50\){event.value="ALTO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.red;} else if\(valor<=75\){event.value="M\311DIO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.yellow;} else {event.value="BAIXO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.green;})/S/JavaScript>>
endobj

