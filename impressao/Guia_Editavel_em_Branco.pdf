2723 0 obj
<</S/JavaScript/JS(// Linha 1: NA no item 4.6.3 sai do denominador.\nvar nomes = ["Group350", "Group351", "Group352", "Group353", "Group354", "Group355"];\nvar soma = 0, total = 0, incompleto = false;\nfor \(var i = 0; i < nomes.length; i++\) {\n    var resposta = String\(this.getField\(nomes[i]\).value\);\n    if \(i === 0 && resposta === "2"\) continue;\n    total++;\n    if \(resposta === "1"\) soma++;\n    else if \(resposta !== "0"\) incompleto = true;\n}\nevent.value = incompleto || total === 0 ? "" : Math.round\(100 * soma / total\) + "%";\n)>>
endobj

2724 0 obj
<</Type/Annot/Subtype/Widget/AA<</C 2725 0 R>>/AP<</N 6722 0 R>>/DA(0 g\n/Helvetica 12 Tf)/DR<</Encoding<</PDFDocEncoding 6 0 R>>/Font<</Helv 5 0 R>>>>/F 4/FT/Tx/MK<</BC[0]/BG[1]>>/P 2721 0 R/Q 1/Rect[233.64 585.8532 311.88 601.6932]/T(fill_3_4)/TU<FEFF20DD002000530049004D0020002F002020DD0020004E00C3004F005F00250020004100540045004E004400490044004F>/DV()/Ff 0>>
endobj

2725 0 obj
<</JS(// Obt\351m os valores dos campos\r\nvar g1 = +this.getField\("Group356"\).value;\r\nvar g2 = +this.getField\("Group357"\).value;\r\nvar g3 = +this.getField\("Group358"\).value;\r\nvar g4 = +this.getField\("Group359"\).value;\r\nvar g5 = +this.getField\("Group360"\).value;\r\nvar g6 = +this.getField\("Group361"\).value;\r\n\r\nif \(g1 === 2\){\r\n    var total = 5;\r\n    var soma = g2 + g3 + g4 + g5 + g6;\r\n} else {\r\n    var total = 6;\r\n    var soma = g1 + g2 + g3 + g4 + g5 + g6;\r\n}\r\n\r\n// Se todos estiverem em branco ou zero, deixa o campo vazio\r\nif \(isNaN\(soma\) || soma === 0\) {\r\n    event.value = "";\r\n} else {\r\n    var porcentagem = \(soma / total\) * 100;\r\n    event.value = porcentagem.toFixed\(0\) + "%";\r\n}\r\nif \(g1 === 0 && g2 === 0 && g3 === 0 && g4 === 0 && g5 === 0 && g6 === 0\) \r\n  event.value = "0 %";\r\nif \(g1 === 2 && g2 === 0 && g3 === 0 && g4 === 0 && g5 === 0 && g6 === 0\) \r\n  event.value = "0 %";)/S/JavaScript>>
endobj

