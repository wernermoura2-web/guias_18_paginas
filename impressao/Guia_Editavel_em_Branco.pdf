3359 0 obj
<</JS(// Nome do campo que cont\351m a porcentagem\r\nvar campoPercentual = this.getField\("fill_2_4"\).value;\r\n\r\n// Remove o s\355mbolo % \(caso exista\) e converte em n\372mero\r\nvar valor = parseFloat\(campoPercentual\);\r\n\r\n// Se o valor n\343o for v\341lido \(vazio, NaN etc.\), deixa o campo em branco\r\nif \(isNaN\(valor\)\) {event.value="";} else if\(valor<50\){event.value="ALTO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.red;} else if\(valor<=75\){event.value="M\311DIO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.yellow;} else {event.value="BAIXO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.green;})/S/JavaScript>>
endobj

3360 0 obj
<</JS(// Obt\351m o valor selecionado no dropdown\r\nvar valor = this.getField\("Dropdown41"\).value; // altere "nivel" se o campo tiver outro nome\r\n\r\n// Obt\351m o checkbox \(Group\) que deve mudar de cor\r\nvar campo = this.getField\("Group241"\);\r\n\r\n// Verifica se o campo existe antes de aplicar as cores\r\nif \(campo\) {\r\n    switch \(valor\) {\r\n        case "ALTO":\r\n            campo.fillColor = color.red; // fundo vermelho\r\n    campo.strokeColor = color.red;\r\n            break;\r\n        case "M\311DIO":\r\n            campo.fillColor = color.yellow; // fundo amarelo\r\n    campo.strokeColor = color.yellow;\r\n            break;\r\n        case "BAIXO":\r\n            campo.fillColor = color.green; // fundo verde\r\n   campo.strokeColor = color.green;\r\n            break;\r\n        default:\r\n            campo.fillColor = color.white; // padr\343o\r\n    }\r\n})/S/JavaScript>>
endobj

