3502 0 obj
<</JS(// Obt\351m os valores dos campos\r\nvar g1 = +this.getField\("Group418"\).value;\r\nvar g2 = +this.getField\("Group419"\).value;\r\nvar g3 = +this.getField\("Group420"\).value;\r\nvar g4 = +this.getField\("Group421"\).value;\r\nvar g5 = +this.getField\("Group422"\).value;\r\nvar g6 = +this.getField\("Group423"\).value;\r\n\r\n// Conta quantos campos foram respondidos \(para evitar divis\343o por zero\)\r\nvar total = 6; // n\372mero total de perguntas\r\nvar soma = g1 + g2 + g3 + g4 + g5 + g6;\r\n\r\n// Se todos estiverem em branco ou zero, deixa o campo vazio\r\nif \(isNaN\(soma\) || soma === 0\) {\r\n    event.value = "";\r\n} else {\r\n    var porcentagem = \(soma / total\) * 100;\r\n    event.value = porcentagem.toFixed\(0\) + "%";\r\n}\r\nif \(g1 === 0 && g2 === 0 && g3 === 0 && g4 === 0 && g5 === 0 && g6 === 0\) \r\n  event.value = "0 %";)/S/JavaScript>>
endobj

