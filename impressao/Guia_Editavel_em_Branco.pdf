<</JS(// Obt\351m o valor selecionado no dropdown\r\nvar valor = this.getField\("Dropdown3"\).value; // altere "nivel" se o campo tiver outro nome\r\n\r\n// Obt\351m o checkbox \(Group\) que deve mudar de cor\r\nvar campo = this.getField\("Group222"\);\r\n\r\n// Verifica se o campo existe antes de aplicar as cores\r\nif \(campo\) {\r\n    switch \(valor\) {\r\n        case "ALTO":\r\n            campo.fillColor = color.red; // fundo vermelho\r\n    campo.strokeColor = color.red;\r\n            break;\r\n        case "M\311DIO":\r\n            campo.fillColor = color.yellow; // fundo amarelo\r\n    campo.strokeColor = color.yellow;\r\n            break;\r\n        case "BAIXO":\r\n            campo.fillColor = color.green; // fundo verde\r\n   campo.strokeColor = color.green;\r\n            break;\r\n        default:\r\n            campo.fillColor = color.white; // padr\343o\r\n    }\r\n})/S/JavaScript>>
endobj

