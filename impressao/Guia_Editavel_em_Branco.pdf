4098 0 obj
<</JS(// Nome do checkbox que controla a condi\347\343o\r\nvar controle = this.getField\("Group200"\); // substitua pelo nome real do checkbox de controle\r\n\r\n// Dropdown com os n\355veis\r\nvar nivel = this.getField\("Dropdown56"\); // substitua "nivel" pelo nome do seu campo dropdown\r\n\r\n// Obt\351m o checkbox \(Group\) que deve mudar de cor\r\nvar campo = this.getField\("Group253"\);\r\n\r\n// Refer\352ncia ao checkbox que mudar\341 de cor\r\n// var campo = event.target;\r\n\r\n// Verifica se o checkbox de controle est\341 marcado\r\nif \(controle.value === "0"\) {\r\n\r\n    // Se estiver marcado, muda a cor conforme o dropdown\r\n    switch \(nivel.value\) {\r\n        case "ALTO":\r\n            campo.fillColor = color.red; // vermelho\r\n            campo.strokeColor = color.red;\r\n            break;\r\n        case "M\311DIO":\r\n            campo.fillColor = color.yellow; // amarelo\r\n            campo.strokeColor = color.yellow;\r\n            break;\r\n        case "BAIXO":\r\n            campo.fillColor = color.green; // verde\r\n            campo.strokeColor = color.green;\r\n            break;\r\n        default:\r\n            campo.fillColor = color.white; // padr\343o se o dropdown estiver vazio\r\n    }\r\n\r\n} else {\r\n    // Se o checkbox de controle N\303O estiver marcado, n\343o muda nada\r\n    // \(ou, se quiser for\347ar a cor branca, descomente a linha abaixo\)\r\n    campo.fillColor = color.white;\r\n}\r\n)/S/JavaScript>>
endobj

