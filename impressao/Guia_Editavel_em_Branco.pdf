<</JS(// Obt\351m o checkbox \(Group\) que deve mudar de cor\r\nvar campo = this.getField\("Dropdown58"\);\r\n\r\n\r\n// Se o valor n\343o for v\341lido \(vazio, NaN etc.\), deixa o campo em branco\r\nif \(campo.value === "ALTO"\) {\r\n    campo.strokeColor = color.red;\r\n} else if \(campo.value === "M\311DIO"\) {\r\n    campo.strokeColor = color.yellow;\r\n} else if \(campo.value === "BAIXO"\) {\r\n    campo.strokeColor = color.green;\r\n} else {\r\n    campo.fillColor = color.white; // padr\343o\r\n})/S/JavaScript>>
