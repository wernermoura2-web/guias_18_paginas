<</JS(// Obt\351m os valores dos campos\r\nvar g1 = +this.getField\("Group371"\).value;\r\nvar g2 = +this.getField\("Group372"\).value;\r\nvar g3 = +this.getField\("Group373"\).value;\r\nvar g4 = +this.getField\("Group374"\).value;\r\nvar g5 = +this.getField\("Group375"\).value;\r\nvar g6 = +this.getField\("Group376"\).value;\r\nvar g7 = +this.getField\("Group377"\).value;\r\n\r\nif \(g1 === 2\){\r\n    var total = 6;\r\n    var soma = g2 + g3 + g4 + g5 + g6 + g7;\r\n} else {\r\n    var total = 7;\r\n    var soma = g1 + g2 + g3 + g4 + g5 + g6 + g7;\r\n}\r\n\r\n// Se todos estiverem em branco ou zero, deixa o campo vazio\r\nif \(isNaN\(soma\) || soma === 0\) {\r\n    event.value = "";\r\n} else {\r\n    var porcentagem = \(soma / total\) * 100;\r\n    event.value = porcentagem.toFixed\(0\) + "%";\r\n}\r\nif \(g1 === 0 && g2 === 0 && g3 === 0 && g4 === 0 && g5 === 0 && g6 === 0 && g7 === 0\) \r\n  event.value = "0 %";\r\nif \(g1 === 2 && g2 === 0 && g3 === 0 && g4 === 0 && g5 === 0 && g6 === 0 && g7 === 0\) \r\n  event.value = "0 %";\r\n\r\n)/S/JavaScript>>
