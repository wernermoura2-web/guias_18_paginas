<</JS(// Percorre todos os campos do formul\341rio\r\nfor \(var i = 0; i < this.numFields; i++\) {\r\n    var nomeCampo = this.getNthFieldName\(i\);\r\n    var campo = this.getField\(nomeCampo\);\r\n\r\n    // Verifica se o campo \351 um checkbox\r\n\r\n\r\n    campo.fillColor = color.white;\r\n    campo.strokeColor = color.black;\r\n\r\n\r\n }\r\n)/S/JavaScript>>
