<</S/JavaScript/JS(// Resultado do item 4.6.3: independe da ordem dos cliques.\nvar nomes = ["Group350", "Group356", "Group362"];\nvar temNao = false, temSim = false, temNA = false;\nfor \(var i = 0; i < nomes.length; i++\) {\n    var resposta = String\(this.getField\(nomes[i]\).value\);\n    if \(resposta === "0"\) temNao = true;\n    else if \(resposta === "1"\) temSim = true;\n    else if \(resposta === "2"\) temNA = true;\n}\nthis.getField\("Group371"\).value = temNao ? "0" : \(temSim ? "1" : \(temNA ? "2" : "Off"\)\);\nthis.calculateNow\(\);\n)>>
