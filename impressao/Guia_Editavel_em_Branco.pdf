<</JS(// Nome do checkbox que controla a condi\347\343o\r\nvar controle1 = this.getField\("Group210"\).value; // substitua pelo nome real do checkbox de controle\r\n\r\n// Nome do campo que cont\351m a porcentagem\r\nvar campoPercentual = this.getField\("fill_7_6"\).value;\r\n\r\n// Obt\351m o checkbox \(Group\) que deve mudar de cor\r\nvar campo = this.getField\("Dropdown117"\);\r\n\r\n// Remove o s\355mbolo % \(caso exista\) e converte em n\372mero\r\nvar valor = parseFloat\(campoPercentual\);\r\nvar controle = parseFloat\(controle1\);\r\n\r\n// Se o valor n\343o for v\341lido \(vazio, NaN etc.\), deixa o campo em branco\r\nif \(controle > 0\) {\r\n    event.value = "";\r\n    campo.strokeColor = color.white;\r\n\r\n} else if \( valor <= 50\) {\r\n    event.value = "N";\r\n    campo.strokeColor = color.red;\r\n}  else if \( valor > 50 && valor <= 75 \) {\r\n    event.value = "N";\r\n    campo.strokeColor = color.yellow;\r\n}  else if \(valor > 75 \) {\r\n    event.value = "N";\r\n    campo.strokeColor = color.green;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n       )/S/JavaScript>>
