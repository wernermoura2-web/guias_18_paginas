2723 0 obj
<</S/JavaScript/JS(// Linha 1: NA no item 4.6.3 sai do denominador.\nvar nomes = ["Group350", "Group351", "Group352", "Group353", "Group354", "Group355"];\nvar soma = 0, total = 0, incompleto = false;\nfor \(var i = 0; i < nomes.length; i++\) {\n    var resposta = String\(this.getField\(nomes[i]\).value\);\n    if \(i === 0 && resposta === "2"\) continue;\n    total++;\n    if \(resposta === "1"\) soma++;\n    else if \(resposta !== "0"\) incompleto = true;\n}\nevent.value = incompleto || total === 0 ? "" : Math.round\(100 * soma / total\) + "%";\n)>>
endobj

2724 0 obj
