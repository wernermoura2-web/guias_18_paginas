4319 0 obj
<</JS(// Nome do campo que cont\351m a porcentagem\r\nvar campoPercentual = this.getField\("fill_6_3"\).value;\r\n\r\n// Remove o s\355mbolo % \(caso exista\) e converte em n\372mero\r\nvar valor = parseFloat\(campoPercentual\);\r\n\r\n// Obt\351m o checkbox \(Group\) que deve mudar de cor\r\nvar campo = this.getField\("Dropdown64"\);\r\n\r\n// Se o valor n\343o for v\341lido \(vazio, NaN etc.\), deixa o campo em branco\r\nif \(isNaN\(valor\)\) {event.value="";} else if\(valor<50\){event.value="ALTO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.red;} else if\(valor<=75\){event.value="M\311DIO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.yellow;} else {event.value="BAIXO";if\(typeof campo!=="undefined"\)campo.strokeColor=color.green;})/S/JavaScript>>
endobj

