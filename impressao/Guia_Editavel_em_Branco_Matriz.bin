 parseFloat\(this.getField\(spec[0]\).value\);\n        if \(!isNaN\(n\)\) nivel = n < 50 ? 3 : n <= 75 ? 2 : 1;\n    }\n    for \(i = 0; i < spec[2].length; i++\) {\n        nivel = Math.max\(nivel, guiaSimplificadoNivel.call\(this, spec[2][i]\)\);\n    }\n    return nivel;\n}\nfunction guiaSimplificadoCalcular\(id\) {\n    var nivel = guiaSimplificadoNivel.call\(this, id\);\n    var numerico = guiaSimplificadoRiscos[id][3];\n    var nomes = ["", "BAIXO", "M\311DIO", "ALTO", "ALTO-PCC"];\n    var cores = [color.white, color.green, color.yellow, color.red, color.red];\n    var campo = event.target;\n    event.value = nivel === 4 && campo.type === "text" && campo.multiline\n        ? "ALTO\\rPCC"\n        : \(numerico && nivel > 0 && nivel < 4 ? String\(nivel\) : nomes[nivel]\);\n    if \(campo.type === "text" && campo.multiline\) campo.textColor = nivel === 4 ? color.red : color.black;\n    event.target.strokeColor = cores[nivel];\n    if \(id === 58\) {\n        var grupo = this.getField\("Group279"\);\n        var escolha = nivel ? String\(Math.min\(nivel, 3\) - 1\) : "Off";\n        if \(String\(grupo.value\) !== escolha\) grupo.value = escolha;\n    }\n}\n)>>
